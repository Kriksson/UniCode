{
  "name": "unicode-v1",
  "version": "1.3.0",
  "author": "krkss",
  "desktopName": "unicode-v1.desktop",
  "private": true,
  "description": "Минималистичный настольный клиент для Codex CLI",
  "type": "module",
  "main": "electron/main.mjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "tsc --noEmit && vite build",
    "start": "electron .",
    "test": "node --test tests/*.test.mjs",
    "test:ui": "playwright test",
    "pack": "npm run build && electron-builder --linux dir",
    "dist": "npm run build && electron-builder --linux AppImage"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "lucide-react": "^0.577.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "react-virtuoso": "^4.18.19",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.0",
    "electron": "^45.0.0",
    "electron-builder": "^26.0.12",
    "typescript": "^5.9.3",
    "vite": "^8.3.5"
  },
  "build": {
    "appId": "local.krkss.unicode",
    "productName": "UniCode v1",
    "files": [
      "dist/**/*",
      "electron/**/*",
      "assets/icon.png",
      "assets/attention.wav",
      "package.json"
    ],
    "asarUnpack": [
      "assets/attention.wav"
    ],
    "directories": {
      "output": "release"
    },
    "linux": {
      "syncDesktopName": true,
      "target": [
        "AppImage"
      ],
      "category": "Development",
      "icon": "assets/icon.png"
    }
  }
}
